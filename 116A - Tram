#include <iostream>
using namespace std;

int main()
{
    int n;
    cin>>n;
    int currentPass=0;
    int maxCap=0;
       for(int i=0;i<n;i++){
        int a,b;
        cin>>a>>b;
        currentPass-=a;
        currentPass+=b;
        maxCap=max(maxCap, currentPass);
       }
       cout<<maxCap;

    return 0;
}
