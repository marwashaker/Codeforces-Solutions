import java.util.Scanner;
 public class Main {
    public static void main(String[] args) {
       Scanner in=new Scanner(System.in);
        int k=in.nextInt();
        int n=in.nextInt();
        int w=in.nextInt();
        int cost=k*(w*(w+1))/2;
        int borrow=cost-n;
        if(borrow<0){
            borrow=0;
        }
            System.out.println(borrow);
   }
}
